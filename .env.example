# ─────────────────────────────────────────
# Hostaway
# ─────────────────────────────────────────
# The Hostaway booking website URL the widgets redirect to on "Request to Book".
# Find it in Hostaway > Booking Website settings (your connected booking site domain).
NEXT_PUBLIC_HOSTAWAY_BASE_URL=https://www.yourbaligetaway.com/

# Hostaway API key (Settings > Hostaway API). Only needed if you later query
# bookings/availability server-side. Not required for the embedded widgets.
HOSTAWAY_API_KEY=your_hostaway_api_key_here
HOSTAWAY_ACCOUNT_ID=your_hostaway_account_id_here
