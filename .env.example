# ─────────────────────────────────────────
# Smoobu
# ─────────────────────────────────────────
# Your Smoobu API key (Settings > Advanced > API Keys)
# Used if you want to query bookings server-side in the future
SMOOBU_API_KEY=your_smoobu_api_key_here

# The all-apartments booking widget ID (already set in src/lib/villas.ts)
# Only change this if Smoobu gives you a different ID
NEXT_PUBLIC_SMOOBU_ALL_ID=1690897
